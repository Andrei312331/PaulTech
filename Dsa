const express = require('express');
const bodyParser = require('body-parser');
const jwt = require('jsonwebtoken');

const app = express();
app.use(bodyParser.json());

const SECRET = 'your-secret-key';
// In-memory store for demonstration purposes
const users = [{ id: 1, username: 'admin', password: 'admin' }];
let products = [];
let receipts = [];
let productId = 1;

// Middleware for authenticating JWT token
function authenticateToken(req, res, next) {
  const token = req.headers['authorization']?.split(' ')[1];
  if (!token) return res.sendStatus(401);
  jwt.verify(token, SECRET, (err, user) => {
    if (err) return res.sendStatus(403);
    req.user = user;
    next();
  });
}

// --- Auth ---
app.post('/login', (req, res) => {
  const { username, password } = req.body;
  const user = users.find(u => u.username === username && u.password === password);
  if (!user) return res.status(401).json({ message: 'Invalid credentials' });
  const token = jwt.sign({ id: user.id, username: user.username }, SECRET, { expiresIn: '1h' });
  return res.json({ token });
});

// --- Validation Helper ---
function validateProduct(data) {
  if (!data.name || typeof data.name !== 'string') return 'Name is required';
  if (typeof data.price !== 'number' || data.price < 0) return 'Valid price required';
  if (!Number.isInteger(data.stock) || data.stock < 0) return 'Valid stock required';
  return null;
}

// --- CRUD Products ---
// Create
app.post('/products', authenticateToken, (req, res) => {
  const err = validateProduct(req.body);
  if (err) return res.status(400).json({ error: err });
  const prod = { ...req.body, id: productId++ };
  products.push(prod);
  res.status(201).json(prod);
});

// Read all
app.get('/products', authenticateToken, (req, res) => {
  res.json(products);
});

// Read one
app.get('/products/:id', authenticateToken, (req, res) => {
  const prod = products.find(p => p.id == req.params.id);
  if (!prod) return res.status(404).json({ error: 'Not found' });
  res.json(prod);
});

// Update
app.put('/products/:id', authenticateToken, (req, res) => {
  const err = validateProduct(req.body);
  if (err) return res.status(400).json({ error: err });
  const prod = products.find(p => p.id == req.params.id);
  if (!prod) return res.status(404).json({ error: 'Not found' });
  prod.name = req.body.name;
  prod.price = req.body.price;
  prod.stock = req.body.stock;
  res.json(prod);
});

// Delete
app.delete('/products/:id', authenticateToken, (req, res) => {
  products = products.filter(p => p.id != req.params.id);
  res.status(204).end();
});

// --- Receipt with Discount ---
// Example: POST /receipts { items: [{id: 1, qty: 2}, ...], discount: 10 }
app.post('/receipts', authenticateToken, (req, res) => {
  const { items, discount } = req.body;
  if (!Array.isArray(items) || typeof discount !== 'number' || discount < 0 || discount > 100)
    return res.status(400).json({ error: 'Valid items array and discount 0-100 required' });

  let total = 0;
  const receiptItems = [];

  for (const { id, qty } of items) {
    const prod = products.find(p => p.id == id);
    if (!prod || qty > prod.stock) return res.status(400).json({ error: `Product ID ${id} invalid or not enough stock` });
    prod.stock -= qty; // Decrease stock
    const lineTotal = prod.price * qty;
    receiptItems.push({ product: prod.name, qty, price: prod.price, lineTotal });
    total += lineTotal;
  }

  const discountedTotal = total * (1 - discount / 100);
  const receipt = {
    id: receipts.length + 1,
    items: receiptItems,
    total,
    discount,
    discountedTotal,
    date: new Date()
  };
  receipts.push(receipt);
  res.status(201).json(receipt);
});

// --- Start the server ---
app.listen(3000, () => console.log('Store Management API running on port 3000'));
